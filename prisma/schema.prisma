generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ---------- ENUMS ---------- 
enum InvoiceStatus {  
POR_ENVIAR
PENDIENTE  
PAGADA  
VENCIDA
ANULADA
} 

enum NotificationType {
RECORDATORIO  
REVISION  
VENCIDA  
INFORME
} 

// ---------- TIPO EMBEBIDO ---------- 
type StatusChange {  
status InvoiceStatus
date   DateTime
userId String?       @db.ObjectId
}

// ---------- MODELOS ---------- 
model User {  
id        String   @id @default(auto()) @map("_id") @db.ObjectId  
firstName      String
middleName     String?
lastName       String
secondLastName String? 
email     String   @unique  
password  String  
salt String
active    Boolean  @default(true)  
createdAt DateTime @default(now())
} 

model Client {  
id          String    @id @default(auto()) @map("_id") @db.ObjectId  
name        String  
contactName String  
email       String  
phone       String  
address     String  
paymentDay Int 
notes       String?  
active      Boolean   @default(true)  
invoices    Invoice[]  
createdAt   DateTime  @default(now())  
updatedAt   DateTime  @updatedAt
} 

model Invoice {  
id         String         @id @default(auto()) @map("_id") @db.ObjectId  
number     String         @unique  
clientId   String         @db.ObjectId  
client     Client         @relation(fields: [clientId], references: [id])  
concept    String  
amount     Float  
issueDate  DateTime  
dueDate    DateTime  //día de pago y vence cuando ya pasó, dia siguiente
status     InvoiceStatus  @default(POR_ENVIAR)  
history    StatusChange[]  
sentAt     DateTime?  
paidAt     DateTime?  
canceledAt DateTime?  
pdfUrl     String?  
createdAt  DateTime       @default(now())  
updatedAt  DateTime       @updatedAt

@@index([clientId])
@@index([status, dueDate])
} 

//registro de cada correo que el sistema envía
model Notification {  
id        String           @id @default(auto()) @map("_id") @db.ObjectId  
key       String           @unique  
type      NotificationType  
invoiceId String?          @db.ObjectId  
clientId  String?          @db.ObjectId  
to        String  
sentAt    DateTime         @default(now())  
success   Boolean  
error     String?
}

model Settings {  
id              String   @id @default(auto()) @map("_id") @db.ObjectId  
daysBefore      Int      @default(5)  // días antes del pago para avisar "crea la factura"
reportDays      Int[]    @default([15, 30])  
recipientEmails String[]
}